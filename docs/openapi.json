  "components": {
    "schemas": {
      "ChatIn": {
        "properties": {
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{8,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "message": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatIn"
      },
      "ChatMessageOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "waktu": {
            "type": "string",
            "title": "Waktu"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "content",
          "waktu"
        ],
        "title": "ChatMessageOut"
      },
      "ChatOut": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "reply": {
            "type": "string",
            "title": "Reply"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "reply"
        ],
        "title": "ChatOut"
      },
      "ClassResult": {
        "properties": {
          "class": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Class"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "class",
          "confidence"
        ],
        "title": "ClassResult",
        "description": "Bentuk sama dengan `ripeness` / `defect` pada respons POST /predict di ml/api.py (field lain diabaikan)."
      },
      "DeviceStateOut": {
        "properties": {
          "state": {
            "type": "string",
            "title": "State"
          },
          "firmware_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Firmware Id"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "serial_ok": {
            "type": "boolean",
            "title": "Serial Ok"
          },
          "camera_ok": {
            "type": "boolean",
            "title": "Camera Ok"
          },
          "updated": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated",
            "description": "Epoch detik pesan terakhir dari controller; null bila belum pernah"
          },
          "stale": {
            "type": "boolean",
            "title": "Stale",
            "description": "True bila controller tidak memberi kabar lebih lama dari dashboard.stale_after_s"
          }
        },
        "type": "object",
        "required": [
          "state",
          "firmware_id",
          "message",
          "serial_ok",
          "camera_ok",
          "updated",
          "stale"
        ],
        "title": "DeviceStateOut"
      },
      "EventIn": {
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "INFO",
              "WARN",
              "ERROR"
            ],
            "title": "Level"
          },
          "source": {
            "type": "string",
            "enum": [
              "controller",
              "firmware",
              "api"
            ],
            "title": "Source"
          },
          "message": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "level",
          "source",
          "message"
        ],
        "title": "EventIn"
      },
      "EventOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "waktu": {
            "type": "string",
            "title": "Waktu"
          },
          "level": {
            "type": "string",
            "enum": [
              "INFO",
              "WARN",
              "ERROR"
            ],
            "title": "Level"
          },
          "source": {
            "type": "string",
            "enum": [
              "controller",
              "firmware",
              "api"
            ],
            "title": "Source"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "id",
          "waktu",
          "level",
          "source",
          "message"
        ],
        "title": "EventOut"
      },
      "FirmwareMessage": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "READY",
              "DETECT",
              "ACK",
              "DONE",
              "ERR"
            ],
            "title": "Type"
          },
          "id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "grade": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "A",
                  "B",
                  "C"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Grade"
          },
          "code": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z_]{1,32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "type"
        ],
        "title": "FirmwareMessage",
        "description": "Pesan firmware apa adanya, sama dengan keluaran controller.protocol.parse_message."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Overview": {
        "properties": {
          "server_time": {
            "type": "number",
            "title": "Server Time"
          },
          "state": {
            "$ref": "#/components/schemas/DeviceStateOut"
          },
          "stats": {
            "$ref": "#/components/schemas/StatsOut"
          },
          "last_tomato": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TomatoOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "has_frame": {
            "type": "boolean",
            "title": "Has Frame"
          },
          "settings": {
            "additionalProperties": true,
            "type": "object",
            "title": "Settings"
          }
        },
        "type": "object",
        "required": [
          "server_time",
          "state",
          "stats",
          "last_tomato",
          "has_frame",
          "settings"
        ],
        "title": "Overview"
      },
      "StatsOut": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "per_grade": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Per Grade"
          },
          "error_count": {
            "type": "integer",
            "title": "Error Count"
          },
          "avg_latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avg Latency Ms"
          },
          "per_minute": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Per Minute",
            "description": "Tomat per menit, terlama dulu; elemen terakhir = menit berjalan"
          }
        },
        "type": "object",
        "required": [
          "total",
          "per_grade",
          "error_count",
          "avg_latency_ms",
          "per_minute"
        ],
        "title": "StatsOut"
      },
      "StatusIn": {
        "properties": {
          "state": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "READY",
                  "DETECT",
                  "GRADING",
                  "ACK",
                  "DONE",
                  "ERR"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          },
          "firmware_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Firmware Id"
          },
          "message": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "serial_ok": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Serial Ok"
          },
          "camera_ok": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Camera Ok"
          }
        },
        "type": "object",
        "title": "StatusIn",
        "description": "Heartbeat controller. Semua field opsional; yang kosong tidak mengubah nilai sebelumnya."
      },
      "TomatoIn": {
        "properties": {
          "firmware_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Firmware Id",
            "description": "ID dari firmware (DETECT,<id>)"
          },
          "ripeness": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClassResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "defect": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClassResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "grade": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C"
            ],
            "title": "Grade"
