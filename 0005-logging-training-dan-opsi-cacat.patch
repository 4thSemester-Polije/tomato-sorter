+) -> list[Any]:
+    """Callback pencatat per epoch (CSV + log) dan, opsional, TensorBoard."""
+    if run is None:
+        return []
+    callbacks: list[Any] = [
+        make_keras_callback(EpochRecorder(run.history_path, task, phase, epoch_offset))
+    ]
+    if tensorboard and importlib.util.find_spec("tensorboard") is None:
